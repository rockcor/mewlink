{
  "name": "mewlink",
  "private": true,
  "version": "0.3.28",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:animations": "node scripts/validate-animation-assets.mjs",
    "test:peer": "node scripts/test-peer.mjs",
    "test:relay-server": "cargo build --manifest-path src-tauri/Cargo.toml --example ratchet_peer && vitest run --config tests/relay.config.ts",
    "test:release": "node --test tests/release-pipeline.test.mjs",
    "test:live:production": "cargo build --manifest-path src-tauri/Cargo.toml --example ratchet_peer && VITE_RELAY_ENDPOINT=https://mewlink.jshmhsb.chatgpt.site/api/relay vitest run --config tests/live-production.config.ts",
    "test:live": "cargo build --manifest-path src-tauri/Cargo.toml --example ratchet_peer && vitest run --config tests/live.config.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.3",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "idb": "^8.0.3",
    "libsodium-wrappers-sumo": "^0.8.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "fake-indexeddb": "^6.2.4",
    "sharp": "0.34.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.1"
}
